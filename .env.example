# Copy to .env — never commit a real .env
TRAIL_ENV=sandbox                 # sandbox | production (production fails fast on unsafe config)
TRAIL_MASTER_SECRET=              # 32+ random chars: python -c "import secrets;print(secrets.token_hex(32))"
TRAIL_AUDIT_PATH=./audit.jsonl    # durable hash-chained audit log
TRAIL_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
TRAIL_LOG_LEVEL=INFO
# Production: hashed API keys, e.g. {"<sha256 of key>": {"user_id":"rav","role":"l2_approver"}}
TRAIL_USERS_JSON=
