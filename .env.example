# Copy to .env for local use only — never commit a real .env
# Explicit profiles: sandbox | staging | production_unsupported
TRAIL_ENV=sandbox
TRAIL_PROFILE=sandbox
TRAIL_DATA_STATUS=synthetic
TRAIL_LIVE_INTEGRATIONS=false
TRAIL_MASTER_SECRET=              # sandbox may use the built-in demo default; staging needs 32+ random chars
TRAIL_AUDIT_PATH=./audit.jsonl    # staging must be durable and outside an ephemeral container layer
TRAIL_PREAUTH_PATH=./preauth.sqlite
TRAIL_DEPENDENCY_LOCK=            # required by staging; point to a checked-in local lock
TRAIL_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
TRAIL_BIND_HOST=127.0.0.1       # non-local container binding requires explicit opt-in
TRAIL_LOG_LEVEL=INFO
TRAIL_DISABLE_DEV_KEYS=0          # set to 1 outside sandbox
# Staging: hashed API keys with an institution on every principal.
TRAIL_USERS_JSON=
